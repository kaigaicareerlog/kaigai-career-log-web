---
import { Briefcase, Building2, MapPin } from '@lucide/astro';
import type { EpisodeMeta } from '../../types';
import {
  getEpisodePills,
  type EpisodePillVariant,
} from '../../utils/episodeMeta/getEpisodePills';
import { getLinkableTagSlugs } from '../../utils/episodeMeta/getLinkableTagSlugs';
import { getTagPagePath } from '../../utils/episodeMeta/getTagPages';
import Badge from '../ui/Badge.astro';

interface Props {
  meta?: EpisodeMeta;
  /** 'card' is compact; 'page' shows every pill plus topics */
  variant?: EpisodePillVariant;
  class?: string;
}

const { meta, variant = 'card', class: className = '' } = Astro.props;
const pills = getEpisodePills(meta, variant);
const linkable = await getLinkableTagSlugs();

// Place and topic badges link to their tag page when there is one. `relative
// z-10` keeps them clickable above a card's full-card link.
const hrefFor = (slug?: string) =>
  slug && linkable.has(slug) ? getTagPagePath(slug) : undefined;
---

{
  pills.length > 0 && (
    <ul class:list={['flex flex-wrap gap-1.5', className]}>
      {pills.map((pill) => (
        <li>
          {pill.kind === 'position' && (
            <Badge variant="secondary">
              <Briefcase class="size-3" aria-hidden="true" />
              {pill.label}
            </Badge>
          )}
          {pill.kind === 'company' && (
            <Badge>
              <Building2 class="size-3" aria-hidden="true" />
              {pill.label}
            </Badge>
          )}
          {pill.kind === 'place' && (
            <Badge href={hrefFor(pill.slug)} class="relative z-10">
              <MapPin class="size-3" aria-hidden="true" />
              {pill.label}
            </Badge>
          )}
          {pill.kind === 'topic' && (
            <Badge
              variant="brand"
              href={hrefFor(pill.slug)}
              class="relative z-10"
            >
              {pill.label}
            </Badge>
          )}
        </li>
      ))}
    </ul>
  )
}
