---
import { Calendar, Clock } from '@lucide/astro';
import {
  AMAZON_MUSIC_CHANNEL_URL,
  APPLE_PODCAST_CHANNEL_URL,
  SPOTIFY_CHANNEL_URL,
  YOUTUBE_CHANNEL_URL,
} from '../../constants/podcastUrls';
import type { PodcastEpisode } from '../../types';
import { buildEpisodeSearchText } from '../../utils/episodeMeta/buildEpisodeSearchText';
import { getEpisodeMeta } from '../../utils/episodeMeta/episodeMetaFile';
import { getEpisodeFilterTags } from '../../utils/episodeMeta/getEpisodeFilterTags';
import { formatDate, formatDuration } from '../../utils/formatters';
import { getEpisodeExcerpt } from '../../utils/getEpisodeExcerpt';
import Button from '../ui/Button.astro';
import EpisodeMetaPills from './EpisodeMetaPills.astro';

interface Props {
  podcast: PodcastEpisode;
}

const { podcast } = Astro.props;

// Use episode-specific URLs if available, otherwise the show's channel page
const platforms = [
  { label: 'Spotify', href: podcast.spotifyUrl || SPOTIFY_CHANNEL_URL },
  {
    label: 'Apple Podcasts',
    href: podcast.applePodcastUrl || APPLE_PODCAST_CHANNEL_URL,
  },
  { label: 'YouTube', href: podcast.youtubeUrl || YOUTUBE_CHANNEL_URL },
  {
    label: 'Amazon Music',
    href: podcast.amazonMusicUrl || AMAZON_MUSIC_CHANNEL_URL,
  },
];

// Guest info/tags: shown as pills, and searched (including the guest's name)
const meta = getEpisodeMeta(podcast.guid);
const searchText = buildEpisodeSearchText(podcast, meta);
const tags = getEpisodeFilterTags(podcast.title, meta).join(' ');
---

<article
  class="relative rounded-xl border bg-card p-5 transition-colors hover:bg-accent/40"
  data-search={searchText}
  data-tags={tags}
>
  <h3 class="mb-2 line-clamp-2 text-base leading-snug font-semibold">
    <a href={`/episodes/${podcast.guid}/`} class="after:absolute after:inset-0">
      {podcast.title}
    </a>
  </h3>
  <EpisodeMetaPills meta={meta} variant="card" class="mb-3" />
  <p class="mb-4 line-clamp-2 text-sm leading-relaxed text-muted-foreground">
    {getEpisodeExcerpt(podcast.description)}
  </p>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <p class="flex items-center gap-3 text-xs text-muted-foreground">
      <span class="inline-flex items-center gap-1">
        <Calendar class="size-3.5" aria-hidden="true" />
        {formatDate(podcast.date)}
      </span>
      <span class="inline-flex items-center gap-1">
        <Clock class="size-3.5" aria-hidden="true" />
        {formatDuration(podcast.duration)}
      </span>
    </p>
    <div class="relative z-10 flex flex-wrap gap-1.5">
      {
        platforms.map((platform) => (
          <Button href={platform.href} size="sm" external>
            {platform.label}
          </Button>
        ))
      }
    </div>
  </div>
</article>
