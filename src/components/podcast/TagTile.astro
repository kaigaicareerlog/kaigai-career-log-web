---
interface Props {
  /** Leave out for a tile that isn't a link (e.g. a city without its own page) */
  href?: string;
  label: string;
  count: number;
}

const { href, label, count } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag
  {...href ? { href } : {}}
  class:list={[
    'flex items-center justify-between gap-3 rounded-lg border px-4 py-3 text-sm',
    href && 'transition-colors hover:bg-accent',
  ]}
>
  <span class="font-medium">{label}</span>
  <span class="shrink-0 text-muted-foreground">{count}話</span>
</Tag>
