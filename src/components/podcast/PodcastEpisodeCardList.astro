---
import type { PodcastEpisode } from '../../types';
import EpisodeSearch from './EpisodeSearch.astro';
import PodcastEpisodeCard from './PodcastEpisodeCard.astro';

interface Props {
  episodes: PodcastEpisode[];
}

const { episodes } = Astro.props;
---

<section id="episodes" class="mx-auto w-full max-w-5xl scroll-mt-20 px-4 pt-12">
  <div class="mb-4 flex items-baseline justify-between">
    <h2 class="text-2xl font-semibold tracking-tight">エピソード</h2>
    <p class="text-sm text-muted-foreground">全{episodes.length}話</p>
  </div>
  <EpisodeSearch />
  {
    episodes.length > 0 ? (
      <div class="grid gap-3">
        {episodes.map((podcast) => (
          <PodcastEpisodeCard podcast={podcast} />
        ))}
      </div>
    ) : (
      <p class="py-12 text-center text-muted-foreground">
        エピソードが見つかりませんでした。
      </p>
    )
  }
</section>
