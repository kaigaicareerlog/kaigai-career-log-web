---
import { Search } from '@lucide/astro';
import {
  FEATURED_FILTER_TAGS,
  SPECIAL_EPISODE_FILTER,
} from '../../constants/episodeFilters';
import { findTagBySlug } from '../../utils/episodeMeta/resolveTag';

/**
 * Search box + quick-filter chips for the episode list. Filters the cards
 * on the page by their `data-search` text and `data-tags`. The list is fully
 * rendered in the HTML, so the page stays crawlable; this only hides
 * non-matching cards in the browser.
 */
const tagChips = FEATURED_FILTER_TAGS.flatMap(({ kind, slug }) => {
  const tag = findTagBySlug(kind, slug);
  return tag ? [{ slug, label: tag.label }] : [];
});
// 特別回 comes first: it separates episode types, the rest are topics
const chips = [SPECIAL_EPISODE_FILTER, ...tagChips];
---

<div role="search" class="mb-6 space-y-3">
  <label class="sr-only" for="episode-search-input">エピソードを検索</label>
  <div
    class="flex h-10 items-center gap-2 rounded-md border border-input px-3 transition-shadow focus-within:ring-2 focus-within:ring-ring"
  >
    <Search class="size-4 shrink-0 text-muted-foreground" aria-hidden="true" />
    <input
      id="episode-search-input"
      type="search"
      placeholder="職種・会社・都市・名前で検索（例: バンクーバー SRE）"
      autocomplete="off"
      enterkeyhint="search"
      class="h-full min-w-0 flex-1 bg-transparent text-sm outline-none placeholder:text-muted-foreground"
    />
  </div>
  <div class="flex flex-wrap gap-1.5" id="episode-filter-chips">
    {
      chips.map((chip) => (
        <button
          type="button"
          data-tag={chip.slug}
          aria-pressed="false"
          class="h-7 cursor-pointer rounded-md border px-2.5 text-xs transition-colors hover:bg-accent aria-pressed:border-primary aria-pressed:bg-primary aria-pressed:text-primary-foreground"
        >
          {chip.label}
        </button>
      ))
    }
  </div>
  <p
    id="episode-search-status"
    class="min-h-5 text-sm text-muted-foreground"
    aria-live="polite"
  >
  </p>
</div>

<script>
  import {
    matchesTags,
    matchesTerms,
    tokenizeQuery,
  } from '../../utils/episodeMeta/searchText';

  const input = document.getElementById(
    'episode-search-input'
  ) as HTMLInputElement | null;
  const status = document.getElementById('episode-search-status');
  const chips = Array.from(
    document.querySelectorAll<HTMLButtonElement>('#episode-filter-chips button')
  );
  const cards = Array.from(
    document.querySelectorAll<HTMLElement>('[data-search]')
  );

  if (input && status && cards.length > 0) {
    const applyFilter = () => {
      const terms = tokenizeQuery(input.value);
      const activeTags = chips
        .filter((chip) => chip.getAttribute('aria-pressed') === 'true')
        .map((chip) => chip.dataset.tag ?? '');
      let shown = 0;

      for (const card of cards) {
        const tags = (card.dataset.tags ?? '').split(' ').filter(Boolean);
        const isMatch =
          matchesTerms(card.dataset.search ?? '', terms) &&
          matchesTags(tags, activeTags);
        card.hidden = !isMatch;
        if (isMatch) shown++;
      }

      if (terms.length === 0 && activeTags.length === 0) {
        status.textContent = '';
      } else if (shown === 0) {
        status.textContent = '条件に合うエピソードが見つかりませんでした';
      } else {
        status.textContent = `${shown}件のエピソードが見つかりました`;
      }
    };

    // Don't filter while a Japanese IME is still composing (half-typed kana)
    input.addEventListener('input', (event) => {
      if (!(event as InputEvent).isComposing) applyFilter();
    });
    input.addEventListener('compositionend', applyFilter);

    for (const chip of chips) {
      chip.addEventListener('click', () => {
        const pressed = chip.getAttribute('aria-pressed') === 'true';
        chip.setAttribute('aria-pressed', String(!pressed));
        applyFilter();
      });
    }
  }
</script>
