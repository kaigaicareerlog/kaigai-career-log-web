---
/**
 * shadcn-style button. Renders a link when `href` is given, otherwise a
 * <button>. Use at most one `primary` per view.
 */
interface Props {
  href?: string;
  variant?: 'primary' | 'outline' | 'ghost';
  size?: 'sm' | 'md' | 'icon';
  class?: string;
  external?: boolean;
  [attr: string]: unknown;
}

const {
  href,
  variant = 'outline',
  size = 'md',
  class: className = '',
  external = false,
  ...attrs
} = Astro.props;

const variants = {
  primary: 'bg-primary text-primary-foreground hover:bg-primary/90',
  outline: 'border border-input bg-background hover:bg-accent',
  ghost: 'hover:bg-accent',
};
const sizes = {
  sm: 'h-8 px-3 text-xs',
  md: 'h-9 px-4 text-sm',
  icon: 'size-9',
};

const classes = [
  'inline-flex shrink-0 cursor-pointer items-center justify-center gap-2 rounded-md font-medium whitespace-nowrap transition-colors',
  'focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none',
  variants[variant],
  sizes[size],
  className,
].join(' ');
const Tag = href ? 'a' : 'button';
const linkAttrs = href
  ? { href, ...(external && { target: '_blank', rel: 'noopener noreferrer' }) }
  : { type: 'button' };
---

<Tag class={classes} {...linkAttrs} {...attrs}><slot /></Tag>
