---
import { Image } from 'astro:assets';
import logo from '../../assets/logo.png';
import { SITE_NAME } from '../../constants/site';
import { SPOTIFY_CHANNEL_URL } from '../../constants/podcastUrls';
import Button from '../ui/Button.astro';
import ThemeToggle from './ThemeToggle.astro';

const navLinks = [
  { href: '/#episodes', label: 'エピソード' },
  { href: '/tags/', label: 'トピック' },
  { href: '/about/', label: 'About' },
];
---

<header
  class="sticky top-0 z-40 border-b bg-background/80 backdrop-blur supports-[backdrop-filter]:bg-background/60"
>
  <div class="mx-auto flex h-14 max-w-5xl items-center justify-between px-4">
    <div class="flex items-center gap-6">
      <a href="/" class="flex items-center gap-2 font-semibold">
        <Image
          src={logo}
          alt=""
          width={56}
          height={56}
          class="size-7 rounded-full"
        />
        <span class="hidden sm:inline">{SITE_NAME}</span>
      </a>
      <nav class="flex items-center gap-4 text-sm">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class="whitespace-nowrap text-muted-foreground transition-colors hover:text-foreground"
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>
    <div class="flex items-center gap-2">
      <span class="hidden sm:block">
        <Button href={SPOTIFY_CHANNEL_URL} size="sm" external>
          Spotifyで聴く
        </Button>
      </span>
      <ThemeToggle />
    </div>
  </div>
</header>
