---
import { ArrowRight } from '@lucide/astro';
import { FEATURED_FILTER_TAGS } from '../../constants/episodeFilters';
import {
  getTagPagePath,
  type TagPage,
} from '../../utils/episodeMeta/getTagPages';
import TagTile from '../podcast/TagTile.astro';

interface Props {
  tagPages: TagPage[];
}

const { tagPages } = Astro.props;

// The same tags as the filter chips, limited to those that have a page
const tiles = FEATURED_FILTER_TAGS.flatMap(({ slug }) => {
  const page = tagPages.find((p) => p.slug === slug);
  return page ? [page] : [];
});
---

{
  tiles.length > 0 && (
    <section class="mx-auto max-w-5xl px-4 pt-12">
      <div class="mb-4 flex items-end justify-between gap-4">
        <div>
          <h2 class="text-2xl font-semibold tracking-tight">
            トピックから探す
          </h2>
          <p class="mt-1 text-sm text-muted-foreground">
            気になるテーマや都市のエピソードをまとめて聴けます。
          </p>
        </div>
        <a
          href="/tags/"
          class="inline-flex shrink-0 items-center gap-1 text-sm text-muted-foreground transition-colors hover:text-foreground"
        >
          すべて見る
          <ArrowRight class="size-4" aria-hidden="true" />
        </a>
      </div>
      <div class="grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-3">
        {tiles.map((page) => (
          <TagTile
            href={getTagPagePath(page.slug)}
            label={page.label}
            count={page.episodes.length}
          />
        ))}
      </div>
    </section>
  )
}
