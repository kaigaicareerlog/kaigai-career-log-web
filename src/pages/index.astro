---
import { MapPin, Mic } from '@lucide/astro';
import StartHereSection from '../components/home/StartHereSection.astro';
import TopicTilesSection from '../components/home/TopicTilesSection.astro';
import HostsSection from '../components/podcast/HostsSection.astro';
import LatestEpisodeCard from '../components/podcast/LatestEpisodeCard.astro';
import PodcastEpisodeCardList from '../components/podcast/PodcastEpisodeCardList.astro';
import SponsorCard from '../components/podcast/SponsorCard.astro';
import Badge from '../components/ui/Badge.astro';
import Button from '../components/ui/Button.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { countInterviews } from '../utils/episodeMeta/countInterviews';
import { readEpisodeMetaMap } from '../utils/episodeMeta/episodeMetaFile';
import { getTagPages } from '../utils/episodeMeta/getTagPages';
import { getLatestEpisodes } from '../utils/getLatestEpisodes';
import { getMapEntries } from '../utils/map/getMapEntries';
import { ACTIVE_HOSTS } from '../constants/actors';
import { buildPodcastSeriesJsonLd } from '../utils/seo';

const { episodes } = await getLatestEpisodes();
const latest = episodes[0];
const tagPages = getTagPages(episodes, readEpisodeMetaMap());

const metaMap = readEpisodeMetaMap();
const stats = [
  { value: `${episodes.length}`, label: 'エピソード' },
  { value: `${countInterviews(episodes, metaMap)}`, label: 'インタビュー' },
  {
    // Same as the number of pins on the map (overseas cities plus Tokyo)
    value: `${getMapEntries(episodes, metaMap).length}`,
    label: '都市',
    href: '/cities/',
  },
];
---

<BaseLayout jsonLd={buildPodcastSeriesJsonLd(ACTIVE_HOSTS)}>
  <main class="flex-1">
    <section class="border-b border-brand-border bg-brand-soft">
      <div
        class="mx-auto grid max-w-5xl grid-cols-1 items-center gap-8 px-4 py-12 md:grid-cols-[minmax(0,1fr)_320px] md:py-16"
      >
        <div>
          <Badge variant="brand" class="mb-4">
            <Mic class="size-3" aria-hidden="true" />
            海外キャリアログ · 毎週月曜更新
          </Badge>
          <h1
            class="mb-4 text-3xl leading-tight font-semibold tracking-tight sm:text-4xl"
          >
            <span class="inline-block">海外就職・</span><span
              class="inline-block">海外エンジニアの</span
            ><span class="inline-block">リアルを聞く</span>
          </h1>
          <p
            class="mb-6 max-w-xl text-sm leading-relaxed text-muted-foreground sm:text-base"
          >
            日本から海外に飛び出し、IT業界で活躍する人たちにインタビュー。英語の壁、就活のリアル、ビザや生活事情まで、本音で聞いて記録しています。これから海外キャリアを目指すあなたの道しるべに。
          </p>
          <div class="flex flex-wrap gap-2">
            <Button href={`/episodes/${latest.guid}/`} variant="primary">
              最新回を聴く
            </Button>
            <Button href="#episodes">エピソード一覧</Button>
          </div>
        </div>
        <LatestEpisodeCard episode={latest} />
      </div>
    </section>

    <section class="mx-auto max-w-5xl px-4 pt-8">
      <dl class="grid grid-cols-3 gap-3">
        {
          stats.map((stat) => (
            <div
              class:list={[
                'relative rounded-xl border p-4',
                stat.href && 'transition-colors hover:bg-accent/40',
              ]}
            >
              <dd class="text-2xl font-semibold">{stat.value}</dd>
              <dt class="text-sm text-muted-foreground">
                {stat.href ? (
                  <a href={stat.href} class="after:absolute after:inset-0">
                    {stat.label}
                    <MapPin
                      class="ml-1 inline size-3.5 align-[-2px]"
                      aria-hidden="true"
                    />
                    <span class="sr-only">（地図で見る）</span>
                  </a>
                ) : (
                  stat.label
                )}
              </dt>
            </div>
          ))
        }
      </dl>
    </section>

    <StartHereSection episodes={episodes} tagPages={tagPages} />
    <TopicTilesSection tagPages={tagPages} />
    <PodcastEpisodeCardList episodes={episodes} />

    <section
      class="mx-auto mt-16 grid max-w-5xl grid-cols-1 gap-8 px-4 md:grid-cols-2"
    >
      <HostsSection />
      <SponsorCard />
    </section>
  </main>
</BaseLayout>
