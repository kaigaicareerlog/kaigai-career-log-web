---
import { Mail, MessageSquare } from '@lucide/astro';
import HostsSection from '../components/podcast/HostsSection.astro';
import SponsorCard from '../components/podcast/SponsorCard.astro';
import Badge from '../components/ui/Badge.astro';
import Button from '../components/ui/Button.astro';
import {
  CONTACT_EMAIL,
  CONTACT_FORM_URL,
  X_ACCOUNT_URL,
} from '../constants/contact';
import {
  APPLE_PODCAST_CHANNEL_URL,
  SPOTIFY_CHANNEL_URL,
  YOUTUBE_CHANNEL_URL,
} from '../constants/podcastUrls';
import { FAQ_ITEMS } from '../constants/faq';
import { SITE_NAME } from '../constants/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import { buildBreadcrumbJsonLd, buildFaqPageJsonLd } from '../utils/seo';

const platforms = [
  { label: 'Spotify', href: SPOTIFY_CHANNEL_URL },
  { label: 'Apple Podcasts', href: APPLE_PODCAST_CHANNEL_URL },
  { label: 'YouTube', href: YOUTUBE_CHANNEL_URL },
  { label: 'X', href: X_ACCOUNT_URL },
];
---

<BaseLayout
  title={`海外キャリアログについて（ホスト紹介・番組情報） - ${SITE_NAME}`}
  description="海外キャリアログについて - ホスト紹介、配信先、よくある質問"
  jsonLd={[
    buildBreadcrumbJsonLd([
      { name: SITE_NAME, url: '/' },
      { name: 'About', url: '/about/' },
    ]),
    buildFaqPageJsonLd(FAQ_ITEMS),
  ]}
>
  <main class="flex-1">
    <div class="mx-auto max-w-3xl space-y-12 px-4 py-10">
      <header>
        <Badge variant="brand" class="mb-4">毎週月曜更新</Badge>
        <h1 class="mb-4 text-3xl font-semibold tracking-tight">
          海外キャリアログについて
        </h1>
        <p class="mb-5 leading-relaxed text-muted-foreground">
          日本から海外に飛び出し、IT業界で活躍する専門家たちにインタビュー。なぜ海外を目指したのか？英語の壁、就活のリアル、ビザや生活事情まで、リアルな声を記録していきます。これから海外キャリアを目指すあなたへ、道しるべとなるログをお届けします。
        </p>
        <div class="flex flex-wrap gap-2">
          {
            platforms.map((platform) => (
              <Button href={platform.href} external>
                {platform.label}
              </Button>
            ))
          }
        </div>
      </header>

      <HostsSection compact={false} />
      <SponsorCard />

      <section aria-labelledby="faq-heading">
        <h2 id="faq-heading" class="mb-4 text-2xl font-semibold tracking-tight">
          よくある質問
        </h2>
        <div class="space-y-3">
          {
            FAQ_ITEMS.map((item) => (
              <div class="rounded-xl border p-4">
                <h3 class="mb-1.5 font-semibold">{item.question}</h3>
                <p class="text-sm leading-relaxed text-muted-foreground">
                  {item.answer}
                </p>
                {item.link && (
                  <a
                    href={item.link.href}
                    class="mt-2 inline-block text-sm font-medium text-brand hover:underline"
                  >
                    {item.link.label}
                  </a>
                )}
              </div>
            ))
          }
        </div>
      </section>

      <section id="contact" class="scroll-mt-20">
        <h2 class="mb-2 text-2xl font-semibold tracking-tight">
          お問い合わせ・質問
        </h2>
        <p class="mb-4 text-sm text-muted-foreground">
          番組への感想や質問、ゲスト出演のご相談はこちらから。
        </p>
        <div class="flex flex-wrap gap-2">
          <Button href={`mailto:${CONTACT_EMAIL}`}>
            <Mail class="size-4" aria-hidden="true" />
            メールで連絡
          </Button>
          <Button href={CONTACT_FORM_URL} external>
            <MessageSquare class="size-4" aria-hidden="true" />
            お便りフォーム
          </Button>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
