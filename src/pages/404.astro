---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="ページが見つかりません - 海外キャリアログ" noindex>
  <main class="not-found">
    <h1>ページが見つかりません</h1>
    <p>お探しのページは移動または削除された可能性があります。</p>
    <a href="/" class="home-link">← エピソード一覧に戻る</a>
  </main>
</BaseLayout>

<style>
  .not-found {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 4rem 1rem;
    text-align: center;
  }

  h1 {
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    font-weight: 700;
  }

  p {
    color: var(--color-muted);
  }

  .home-link {
    color: var(--color-primary);
    text-decoration: none;
    font-weight: 500;
  }

  .home-link:hover {
    color: var(--color-secondary);
  }
</style>
