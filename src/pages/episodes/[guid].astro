---
import { Calendar, ChevronRight, Clock } from '@lucide/astro';
import fs from 'fs';
import path from 'path';
import EpisodeUrlModal from '../../components/EpisodeUrlModal.astro';
import EpisodeDescription from '../../components/episode/EpisodeDescription.astro';
import EpisodeHighlights from '../../components/episode/EpisodeHighlights.astro';
import EpisodeTranscript from '../../components/episode/EpisodeTranscript.astro';
import ListenPanel from '../../components/episode/ListenPanel.astro';
import RelatedEpisodes from '../../components/episode/RelatedEpisodes.astro';
import EpisodeMetaPills from '../../components/podcast/EpisodeMetaPills.astro';
import { HOSTS } from '../../constants/actors';
import { META_DESCRIPTION_MAX_LENGTH, SITE_NAME } from '../../constants/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { TranscriptJSON } from '../../types';
import {
  getEpisodeMeta,
  readEpisodeMetaMap,
} from '../../utils/episodeMeta/episodeMetaFile';
import { getEpisodePartner } from '../../utils/episodeMeta/getEpisodePartner';
import { getRelatedEpisodes } from '../../utils/episodeMeta/getRelatedEpisodes';
import { findTagBySlug } from '../../utils/episodeMeta/resolveTag';
import { formatDate, formatDuration } from '../../utils/formatters';
import { getEpisodeNumber } from '../../utils/getEpisodeNumber';
import { getLatestEpisodes } from '../../utils/getLatestEpisodes';
import {
  buildBreadcrumbJsonLd,
  buildPodcastEpisodeJsonLd,
  toAbsoluteUrl,
  truncateText,
} from '../../utils/seo';
import { getSpotifyEmbedUrl } from '../../utils/spotify';

export async function getStaticPaths() {
  const { episodes } = await getLatestEpisodes();

  return episodes.map((episode) => ({
    params: { guid: episode.guid },
    props: { episode },
  }));
}

const { episode } = Astro.props;
const { episodes } = await getLatestEpisodes();

// Load transcript if available
let transcript: TranscriptJSON | null = null;
try {
  const transcriptPath = path.join(
    process.cwd(),
    'public',
    'transcripts',
    `${episode.guid}.json`
  );
  if (fs.existsSync(transcriptPath)) {
    transcript = JSON.parse(fs.readFileSync(transcriptPath, 'utf-8'));
  }
} catch (error) {
  console.error(`Failed to load transcript for ${episode.guid}:`, error);
}

const highlights = [
  transcript?.highlight1,
  transcript?.highlight2,
  transcript?.highlight3,
].filter((highlight): highlight is string => Boolean(highlight));

// Guest info / tags shown as badges
const meta = getEpisodeMeta(episode.guid);

// The other half of a two-part episode, and episodes on similar topics
const metaMap = readEpisodeMetaMap();
const partner = getEpisodePartner(episode, episodes, metaMap);
const related = getRelatedEpisodes(
  episode,
  episodes,
  metaMap,
  partner ? [partner.episode.guid] : []
);

const episodeNumber = getEpisodeNumber(episode.title);

// SEO metadata
const episodePath = `/episodes/${episode.guid}/`;
const speakers = new Set(transcript?.utterances.map((u) => u.speaker));
const keywords = meta
  ? [
      ...meta.countries.map((slug) => findTagBySlug('country', slug)),
      ...meta.cities.map((slug) => findTagBySlug('city', slug)),
      ...meta.roles.map((slug) => findTagBySlug('role', slug)),
      ...meta.topics.map((slug) => findTagBySlug('topic', slug)),
    ].flatMap((tag) => (tag ? [tag.label] : []))
  : [];
const jsonLd = [
  buildPodcastEpisodeJsonLd(episode, toAbsoluteUrl(episodePath), {
    // Hosts heard in the transcript; a host interviewed as the guest is
    // listed once, as the guest
    hostNames: HOSTS.map((host) => host.name).filter(
      (name) => speakers.has(name) && !meta?.guests.some((g) => g.name === name)
    ),
    guests: meta?.guests,
    keywords,
  }),
  buildBreadcrumbJsonLd([
    { name: SITE_NAME, url: '/' },
    { name: episode.title, url: episodePath },
  ]),
];
---

<BaseLayout
  title={`${episode.title} - ${SITE_NAME}`}
  description={truncateText(episode.description, META_DESCRIPTION_MAX_LENGTH)}
  ogType="article"
  ogImage={`/og/episodes/${episode.guid}.png`}
  largeImage
  jsonLd={jsonLd}
>
  <main class="flex-1">
    <div class="mx-auto max-w-5xl px-4 py-8">
      <div class="mb-6 flex items-center justify-between gap-4">
        <nav
          aria-label="パンくず"
          class="flex items-center gap-1 text-sm text-muted-foreground"
        >
          <a href="/#episodes" class="transition-colors hover:text-foreground">
            エピソード
          </a>
          <ChevronRight class="size-3.5" aria-hidden="true" />
          <span>{episodeNumber ? `#${episodeNumber}` : 'エピソード詳細'}</span>
        </nav>
        <!-- Hidden: triple-click opens the episode URL editor -->
        <button
          id="open-urls-modal-btn"
          type="button"
          class="h-8 w-14 cursor-default opacity-0"
          aria-label="Secret URLs modal trigger (triple-click)"></button>
      </div>

      <header class="mb-8">
        <h1
          class="mb-4 text-2xl leading-snug font-semibold tracking-tight sm:text-3xl"
        >
          {episode.title}
        </h1>
        <EpisodeMetaPills meta={meta} variant="page" class="mb-3" />
        <p
          class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-muted-foreground"
        >
          <span class="inline-flex items-center gap-1.5">
            <Calendar class="size-4" aria-hidden="true" />
            {formatDate(episode.date)}
          </span>
          <span class="inline-flex items-center gap-1.5">
            <Clock class="size-4" aria-hidden="true" />
            {formatDuration(episode.duration)}
          </span>
        </p>
        {
          meta && meta.guests.length > 0 && (
            <p class="mt-2 text-xs text-muted-foreground">
              肩書・所属は収録時点の情報です。
            </p>
          )
        }
      </header>

      <div
        class="grid grid-cols-1 gap-8 lg:grid-cols-[minmax(0,1fr)_320px] lg:items-start"
      >
        <div class="order-2 space-y-4 lg:order-1">
          <EpisodeHighlights highlights={highlights} />
          <EpisodeDescription description={episode.description} />
          <EpisodeTranscript utterances={transcript?.utterances ?? []} />
          <RelatedEpisodes partner={partner} related={related} />
        </div>
        <aside class="order-1 lg:sticky lg:top-20 lg:order-2">
          <ListenPanel
            episode={episode}
            embedUrl={getSpotifyEmbedUrl(episode.spotifyUrl)}
          />
        </aside>
      </div>
    </div>
  </main>

  <EpisodeUrlModal />

  <script define:vars={{ episode, transcript }}>
    // Make episode data available globally for the modals
    window.__EPISODE_DATA__ = {
      title: episode.title,
      guid: episode.guid,
      applePodcastUrl: episode.applePodcastUrl || '',
      spotifyUrl: episode.spotifyUrl || '',
      youtubeUrl: episode.youtubeUrl || '',
      amazonMusicUrl: episode.amazonMusicUrl || '',
      highlight1: transcript?.highlight1 || '',
      highlight2: transcript?.highlight2 || '',
      highlight3: transcript?.highlight3 || '',
    };
  </script>

  <script>
    // Hidden URL editor: triple-click the invisible button to open it
    const openUrlsModalBtn = document.getElementById('open-urls-modal-btn');

    if (openUrlsModalBtn) {
      let clickCount = 0;
      let clickTimeout: ReturnType<typeof setTimeout> | null = null;

      openUrlsModalBtn.addEventListener('click', () => {
        clickCount++;

        if (clickTimeout) {
          clearTimeout(clickTimeout);
        }

        if (clickCount === 3) {
          const openModal = (window as any).__openEpisodeUrlModal;
          if (openModal) {
            openModal();
          }
          clickCount = 0;
        } else {
          clickTimeout = setTimeout(() => {
            clickCount = 0;
          }, 1000);
        }
      });
    }
  </script>
</BaseLayout>
